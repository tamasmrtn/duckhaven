# Copy to .env and fill in. .env is gitignored — never commit real values.
# config/engines.yaml references these by name only.

# ── DuckHaven ────────────────────────────────────────────────────────────
DUCKHAVEN_BASE_URL=https://your-deployment.example.com
DUCKHAVEN_WORKSPACE=tpch-bench
# Minted by `tpch-bench setup-service-account`; shown once at creation.
# That command itself needs a local (password-auth) admin's own login for
# one bootstrap call — pass it via --admin-email/--admin-password (an
# owner of DUCKHAVEN_WORKSPACE), and never put the password here.
DUCKHAVEN_PAT=
# A pre-provisioned elastic agent's id (POST /admin/agents/elastic), so
# every scenario runs against the same fixed-size compute rather than a
# pool-triggered default — the counterpart to DATABRICKS_WAREHOUSE_ID and
# SNOWFLAKE_WAREHOUSE below. Optional; omit to use pool-triggered default sizing.
DUCKHAVEN_AGENT_ID=

# ── Snowflake ────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
# The warehouse for whichever sizing tier is being run
# (config/sizing_matrix.yaml) — provisioned manually for now.
SNOWFLAKE_WAREHOUSE=

# ── Databricks ───────────────────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# The id of a Serverless SQL Warehouse (see Risks in the plan — Serverless
# only, to avoid a separate AWS bill on top of the DBU trial credit).
DATABRICKS_WAREHOUSE_ID=

# ── Corpus storage (standalone Azure Storage Account, outside Terraform) ──
CORPUS_AZURE_CONNECTION_STRING=
CORPUS_AZURE_CONTAINER=tpch-corpus
# Set only if the Databricks workspace's cloud requires a same-cloud
# replica (confirmed AWS for this project — see METHODOLOGY.md).
CORPUS_S3_BUCKET=
CORPUS_AWS_ACCESS_KEY_ID=
CORPUS_AWS_SECRET_ACCESS_KEY=
