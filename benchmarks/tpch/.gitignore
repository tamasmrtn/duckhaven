# Secrets — connection credentials for DuckHaven/Snowflake/Databricks live
# here, never in config/*.yaml (which hold env var names only).
.env

# Local virtual environment / lockfile artifacts for this standalone project.
.venv/

# Results ledger and durable run logs are real, potentially large artifacts
# generated by actually running the benchmark — not source, and (per the
# methodology) published separately as a redacted export, not committed raw.
db/*.duckdb
runs/

# Generated TPC-H Parquet corpus is regenerated by `tpch-bench generate`,
# not checked in.
corpus/
