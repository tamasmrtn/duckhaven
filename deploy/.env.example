# Every variable below is optional. With no .env at all, the stack
# auto-generates persistent secrets on first boot.

# Pin a specific image tag (e.g. v1.2.3) instead of riding :latest.
# DUCKHAVEN_IMAGE_TAG=latest

# Override the auto-generated secrets. Captured to the secrets volume on
# first boot and reused thereafter.
# SECRET_KEY=your-long-random-string
# POSTGRES_PASSWORD=your-postgres-password

# Set true only when the API is served over HTTPS (TLS terminator in front).
# COOKIE_SECURE=true
