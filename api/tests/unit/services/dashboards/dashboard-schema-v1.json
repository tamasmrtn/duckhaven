        "type"
      ],
      "title": "KpiWidget",
      "type": "object"
    },
    "LineColumns": {
      "additionalProperties": false,
      "properties": {
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Split one y column into a line per value of this column.",
          "title": "Series"
        },
        "x": {
          "description": "The time column.",
          "title": "X",
          "type": "string"
        },
        "y": {
          "description": "One line per column.",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Y",
          "type": "array"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "LineColumns",
      "type": "object"
    },
