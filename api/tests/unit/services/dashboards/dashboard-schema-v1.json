              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "description": "Unique in the dashboard. Links and filters refer to it.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "ignore": {
          "description": "Dimension parameters this widget does not apply.",
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
