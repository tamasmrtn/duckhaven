          "title": "Type",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Columns of the 12-column row. Omitted widths share what is left.",
