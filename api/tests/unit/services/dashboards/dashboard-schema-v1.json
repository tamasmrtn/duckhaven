    "Row": {
      "additionalProperties": false,
      "properties": {
        "widgets": {
          "items": {
            "discriminator": {
              "mapping": {
                "bar": "#/$defs/BarWidget",
                "kpi": "#/$defs/KpiWidget",
                "line": "#/$defs/LineWidget",
                "table": "#/$defs/TableWidget",
                "text": "#/$defs/TextWidget"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KpiWidget"
              },
              {
                "$ref": "#/$defs/LineWidget"
              },
              {
                "$ref": "#/$defs/BarWidget"
              },
              {
                "$ref": "#/$defs/TableWidget"
              },
              {
                "$ref": "#/$defs/TextWidget"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Widgets",
          "type": "array"
        }
      },
      "required": [
        "widgets"
      ],
      "title": "Row",
      "type": "object"
    },
