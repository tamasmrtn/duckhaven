.git
.venv
**/__pycache__
**/*.pyc
web/node_modules
web/dist
htmlcov
.pytest_cache
.ruff_cache
.coverage
.coverage.*

# Local-only artifacts. These are gitignored but .dockerignore is a separate
# list, and buildkit walks the whole tree — benchmarks/ alone is ~10 GB and
# stalls any build from the repo root.
benchmarks
deploy/terraform
site
test-results
node_modules

# The API image copies docs/ so the assistant can read it, but only the Markdown
# is useful there — the screenshots and the demo video are ~9 MB of the 10 MB and
# are only ever served by the docs site, which mkdocs builds from a checkout.
docs/images
docs/assets
docs/stylesheets
docs/javascripts
