# Every variable below is optional. With no .env at all, the stack
# auto-generates persistent secrets on first boot.

# Pin a specific image tag (e.g. v1.2.3) instead of riding :latest.
# DUCKHAVEN_IMAGE_TAG=latest

# Override the auto-generated secrets. Captured to the secrets volume on
# first boot and reused thereafter.
# SECRET_KEY=your-long-random-string
# POSTGRES_PASSWORD=your-postgres-password

# Polaris (Iceberg REST catalog). Pin the image tag in production.
# POLARIS_IMAGE_TAG=latest
# POLARIS_REALM=POLARIS
# POLARIS_CLIENT_ID=root
# POLARIS_CLIENT_SECRET=s3cr3t
#
# NOTE: Polaris shares the Postgres instance (dedicated `polaris` DB) and reads
# its password from POSTGRES_PASSWORD via compose interpolation. When you enable
# Polaris you MUST set POSTGRES_PASSWORD here (the auto-generated secret-file
# password is not visible to the Polaris container).

# Bundled MinIO object store (backs the local_fs/nas storage backends). Like
# POSTGRES_PASSWORD, these are read by Polaris/MinIO via compose interpolation,
# not the secrets volume — set them here to override the dev defaults in prod.
# MINIO_IMAGE_TAG=latest
# MINIO_MC_IMAGE_TAG=latest
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_BUCKET=warehouse
# S3_REGION=us-east-1
#
# S3_ENDPOINT is the MinIO URL Polaris vends to DuckDB. Agents run on separate
# hosts and MUST be able to reach it, so set it to an address reachable from the
# agent host (e.g. https://minio.example.com or http://<this-host>:9000). It
# defaults to http://localhost:9000, which only works when the agent shares this
# host. S3_ENDPOINT_INTERNAL (default http://minio:9000) is what Polaris uses
# inside the compose network and rarely needs changing.
# S3_ENDPOINT=http://localhost:9000
# S3_ENDPOINT_INTERNAL=http://minio:9000

# Set true only when the API is served over HTTPS (TLS terminator in front).
# COOKIE_SECURE=true

# Bundled DuckHaven agent. The agent-bootstrap one-shot seeds this single-use
# token so the in-stack agent auto-registers; the agent dials the API with it.
# Override in production; the default is fine for a local all-in-one stack.
# AGENT_BOOTSTRAP_TOKEN=dh_boot_localdev_seed
