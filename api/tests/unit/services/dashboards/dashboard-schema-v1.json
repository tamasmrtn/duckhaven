        "params": {
          "description": "SQL placeholders and the parameters they take: $region, $period.start.",
          "maxProperties": 20,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "maxLength": 71,
              "pattern": "^\\$[a-z][a-z0-9_]*(\\.(start|end))?$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "title": "Params",
          "type": "object"
        },
        "query": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A metric query."
        },
        "sql": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inline SQL. Use $name placeholders for the values params binds.",
          "title": "Sql"
