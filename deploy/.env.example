# Every variable below is optional. With no .env at all, the stack
# auto-generates persistent secrets on first boot.

# Pin a specific image tag (e.g. v1.2.3) instead of riding :latest.
# DUCKHAVEN_IMAGE_TAG=latest

# Override the app secret. Captured to the secrets dir (inside the api_data
# volume) on first boot by the API entrypoint and reused thereafter.
# SECRET_KEY=your-long-random-string

# Internal Postgres password. Postgres publishes no port, so this is internal
# only; it is shared with the polaris and api services via compose
# interpolation. Optional — defaults to `duckhaven`; override for a non-default
# deployment.
# POSTGRES_PASSWORD=your-postgres-password

# Polaris (Iceberg REST catalog). Pin the image tag in production.
# POLARIS_IMAGE_TAG=latest
# POLARIS_REALM=POLARIS
# POLARIS_CLIENT_ID=root
# POLARIS_CLIENT_SECRET=s3cr3t

# Bundled MinIO object store (backs the object_store storage backends). These
# are read by Polaris/MinIO via compose interpolation — set them here to
# override the dev defaults in prod.
# MINIO_IMAGE_TAG=latest
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_BUCKET=warehouse
# S3_REGION=us-east-1
#
# S3_ENDPOINT is the MinIO URL Polaris vends to DuckDB. It defaults to the
# in-network http://minio:9000, which is what the bundled agent (running in
# this compose network) needs. When you run agents on OTHER hosts, set it to an
# address reachable from the agent host (e.g. https://minio.example.com or
# http://<this-host>:9000). S3_ENDPOINT_INTERNAL (default http://minio:9000) is
# what Polaris uses inside the compose network and rarely needs changing.
# S3_ENDPOINT=http://minio:9000
# S3_ENDPOINT_INTERNAL=http://minio:9000

# External AWS S3 and Azure ADLS Gen2 backends need NO static credentials here:
# each backend is registered in Admin → Storage with an IAM role ARN (S3, which
# Polaris assumes via STS) or an Entra tenant/app (ADLS, which Polaris consents
# to vend a SAS token). Polaris is configured to accept both storage types via
# SUPPORTED_CATALOG_STORAGE_TYPES=["S3","AZURE"] in docker-compose.yml. See
# docs/deployment/storage.md for the cloud-side IAM / managed-identity setup.

# Set true only when the API is served over HTTPS (TLS terminator in front).
# COOKIE_SECURE=true

# Bundled DuckHaven agent. The API seeds this single-use token on startup so the
# in-stack agent auto-registers; the agent dials the API with it. Override in
# production; the default is fine for a local all-in-one stack.
# AGENT_BOOTSTRAP_TOKEN=dh_boot_localdev_seed

# Session lifetime in seconds (default 7 days). Drives both the server-side
# session expiry and the cookie max-age. Lower it to shorten sign-ins.
# SESSION_MAX_AGE_SECONDS=604800

# ── Identity: OIDC SSO (optional) ─────────────────────────────────────────────
# Delegate sign-in to your OpenID Connect IdP (Okta, Entra ID, Google, Keycloak,
# …). Local accounts keep working alongside it. See docs/guides/connect-idp.md.
# OIDC_ENABLED=true
# OIDC_LABEL=SSO
# OIDC_SERVER_METADATA_URL=https://idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=duckhaven
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_SCOPES=openid email profile groups
# OIDC_GROUPS_CLAIM=groups
# Map IdP group values to DuckHaven global roles (JSON):
# OIDC_GROUP_ROLE_MAP={"dh-admins": "admin"}
# Required behind a TLS proxy; must match your registered redirect URI host:
# OIDC_REDIRECT_BASE_URL=https://duckhaven.example.com

# ── Identity: LDAP / Active Directory (optional, secondary path) ──────────────
# See docs/guides/connect-ldap.md. Always use TLS (ldaps:// or STARTTLS).
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldaps://dc.example.com
# LDAP_USE_START_TLS=false
# LDAP_BIND_DN=cn=svc-duckhaven,ou=svc,dc=example,dc=com
# LDAP_BIND_PASSWORD=your-service-account-password
# LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(mail={email})
# LDAP_EMAIL_ATTR=mail
# LDAP_NAME_ATTR=displayName
# LDAP_GROUP_ATTR=memberOf
# LDAP_GROUP_ROLE_MAP={"cn=dh-admins,ou=groups,dc=example,dc=com": "admin"}
# LDAP_TLS_CA_CERT=/etc/ssl/certs/corp-ca.pem
# LDAP_TIMEOUT_S=10
