    "TextWidget": {
      "additionalProperties": false,
      "description": "A heading or a short note, in Markdown.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "markdown": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "id",
        "type",
        "markdown"
      ],
      "title": "TextWidget",
      "type": "object"
    },
    "TimeRangeParameter": {
      "additionalProperties": false,
      "description": "A window that widgets opt into by writing ``time_range: $name``.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/DashboardTimeRange"
                },
                {
                  "enum": [
                    "today",
                    "last_7_days",
                    "last_30_days",
                    "last_90_days",
                    "last_12_months",
                    "week_to_date",
                    "month_to_date",
                    "quarter_to_date",
                    "year_to_date",
                    "last_week",
                    "last_month",
                    "last_quarter",
                    "last_year"
                  ],
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A preset such as last_30_days, or a window. Omitted: all time.",
          "title": "Default"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
